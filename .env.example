# FastAPI Backend Base URL (leave blank to run with local mock services)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Toggle mock fallback when backend is offline ('true' | 'false')
VITE_USE_MOCK_FALLBACK=true

# PayPal Sandbox Client ID (used when switching from simulated modal to live PayPal JS SDK)
VITE_PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id

# Supabase Project URL & Anon Key (for future direct auth/realtime sync alongside FastAPI)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
